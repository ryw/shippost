# Anthropic API Key (for Claude)
# Get your API key from: https://console.anthropic.com/
# Uncomment and add your key if using Anthropic provider
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Twitter/X API Credentials (for analyze-x command)
# SHIPPOST_X_CLIENT_ID=your_client_id_here
# SHIPPOST_X_API_TIER=free
# TWITTER_CLIENT_SECRET=your_client_secret_here

# Typefully (for staging approved posts)
# TYPEFULLY_API_KEY=your_typefully_api_key_here
# TYPEFULLY_SOCIAL_SET_ID=1
